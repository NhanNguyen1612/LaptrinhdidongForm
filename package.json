{
  "name": "vku-field-survey-pwa",
  "version": "1.0.0",
  "description": "Offline-first inspection form PWA for VKU campus facilities with zero network connectivity requirement.",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "build": "echo 'Static PWA build ready for Cloudflare Pages & Vercel'",
    "deploy:cloudflare": "npx wrangler pages deploy . --project-name=vku-field-survey-pwa",
    "deploy:vercel": "npx vercel --prod",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "keywords": [
    "pwa",
    "vku",
    "offline-first",
    "indexeddb",
    "service-worker",
    "cloudflare-pages",
    "capacitor",
    "android"
  ],
  "author": "VKU Student Developer",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "wrangler": "^3.0.0"
  }
}
